<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application android:label="RupeeRaid" android:icon="@mipmap/raid_launcher"
        android:allowBackup="false" android:theme="@style/RaidTheme"
        android:networkSecurityConfig="@xml/network_security">
        <service android:name=".AlertJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="in.rupeeraid.mobile" android:host="signin"/>
            </intent-filter>
        </activity>
        <activity-alias android:name=".LauncherBolt" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="true" android:icon="@mipmap/raid_launcher" android:roundIcon="@mipmap/raid_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherShield" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="false" android:icon="@mipmap/launcher_stealth_shield" android:roundIcon="@mipmap/launcher_stealth_shield">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherPixel" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="false" android:icon="@mipmap/launcher_pixel_loot" android:roundIcon="@mipmap/launcher_pixel_loot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherNeon" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="false" android:icon="@mipmap/launcher_neon_mono" android:roundIcon="@mipmap/launcher_neon_mono">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherPitch" android:targetActivity=".MainActivity"
            android:exported="true" android:enabled="false" android:icon="@mipmap/launcher_amoled_pitch" android:roundIcon="@mipmap/launcher_amoled_pitch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
