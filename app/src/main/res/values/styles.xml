        <item name="raidSecondary">#38BDF8</item>
        <item name="android:alertDialogTheme">@style/CobaltDialog</item>
    </style>

    <style name="RaidGold" parent="@style/RaidTheme">
        <item name="android:colorAccent">#F59E0B</item>
