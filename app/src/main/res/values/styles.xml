    <style name="RaidDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/raid_dialog</item>
    </style>
    <style name="EmeraldDialog" parent="@style/RaidDialog">
        <item name="android:colorAccent">#10B981</item>
        <item name="android:colorBackgroundFloating">#12141A</item>
        <item name="raidLine">#292C33</item>
