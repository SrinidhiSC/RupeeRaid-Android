<resources>
    <attr name="raidPanel" format="color"/>
    <attr name="raidRaised" format="color"/>
    <attr name="raidLine" format="color"/>
    <attr name="raidBright" format="color"/>
    <attr name="raidSecondary" format="color"/>

    <style name="RaidTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#10B981</item>
        <item name="android:windowBackground">#08090C</item>
        <item name="android:statusBarColor">#08090C</item>
        <item name="android:navigationBarColor">#08090C</item>
        <item name="raidPanel">#12141A</item>
        <item name="raidRaised">#191C24</item>
        <item name="raidLine">#292C33</item>
        <item name="raidBright">#34D399</item>
        <item name="raidSecondary">#06B6D4</item>
        <item name="android:alertDialogTheme">@style/EmeraldDialog</item>
    </style>

    <style name="RaidAmethyst" parent="@style/RaidTheme">
        <item name="android:colorAccent">#A855F7</item>
        <item name="android:windowBackground">#090710</item>
        <item name="android:statusBarColor">#090710</item>
        <item name="android:navigationBarColor">#090710</item>
        <item name="raidPanel">#13101E</item>
        <item name="raidRaised">#1C172B</item>
        <item name="raidLine">#261F3A</item>
