        <item name="raidBright">#FB7185</item>
        <item name="raidSecondary">#F97316</item>
        <item name="android:alertDialogTheme">@style/EmberDialog</item>
    </style>

    <style name="RaidCobalt" parent="@style/RaidTheme">
        <item name="android:colorAccent">#3B82F6</item>
